# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cv_analyzer

# Connection strings (for local development, docker-compose uses env vars above)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_analyzer

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-min-32-chars-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Azure OpenAI (optional - if set, will use Azure instead of OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Azure Blob Storage (optional - for storing CV files)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=cv-files
AZURE_STORAGE_BLOB_URL=https://youraccount.blob.core.windows.net

# Monitoring (optional)
SENTRY_DSN=

# CORS (use * for all or comma-separated origins)
ALLOWED_ORIGINS=*

# Auth: email verification & password recovery
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Email sender (used for verification & reset emails)
MAIL_FROM=CV Analyzer <no-reply@cvanalyzer.com>

# Option A: Resend (https://resend.com) — preferred. Leave SMTP_* empty if used.
RESEND_API_KEY=

# Option B: plain SMTP. Used only if RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=